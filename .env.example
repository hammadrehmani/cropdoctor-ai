# ─────────────────────────────────────────────────────────────────────────────
# AgriGuard AI — Master Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# This repository uses separate environment files for backend and frontend:
#   - Backend:   copy backend/.env.example   → backend/.env
#   - Frontend:  copy frontend/.env.local.example → frontend/.env.local
#
# NEVER commit production credentials or API keys to git.
# ─────────────────────────────────────────────────────────────────────────────

# Backend Core Variables (see backend/.env.example for details):
# APP_ENV=production
# SECRET_KEY=your-secure-production-secret-key
# ALLOWED_ORIGINS=https://agriguard.example.com
# DATABASE_URL=sqlite+aiosqlite:///./agriguard.db
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DIAGNOSIS_MOCK_MODE=false
# ADVISOR_MOCK_MODE=false

# Frontend Core Variables (see frontend/.env.local.example for details):
# NEXT_PUBLIC_API_BASE_URL=https://api.agriguard.example.com
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_EXPERT_WHATSAPP_NUMBER=923001234567
