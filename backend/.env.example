# ─────────────────────────────────────────────────────────────────────────────
# AgriGuard AI — Backend Production & Development Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application Environment ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME=AgriGuard AI
LOG_LEVEL=INFO
SECRET_KEY=changeme-use-a-secure-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (development & local testing — zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./agriguard.db

# PostgreSQL (Alibaba Cloud ApsaraDB RDS / production — uncomment to use)
# DATABASE_URL=postgresql+asyncpg://agriguard_user:secure_password@pg-host:5432/agriguard

# ── ML Models Directory & File Paths ─────────────────────────────────────────
MODEL_DIR=./ml/models

# Phase 2: Unified Multi-Class EfficientNet-B0 Checkpoint
CLASSIFIER_CHECKPOINT=./ml/models/classifier.pt
CLASSIFIER_CLASSES=./ml/models/classifier_classes.json

# Legacy single-crop weights (optional backward compatibility)
CLASSIFIER_WEIGHTS_COTTON=efficientnet_b0_cotton.pt
CLASSIFIER_WEIGHTS_WHEAT=efficientnet_b0_wheat.pt
CLASSIFIER_WEIGHTS_RICE=efficientnet_b0_rice.pt
CLASSIFIER_WEIGHTS_SUGARCANE=efficientnet_b0_sugarcane.pt

# Multilingual RAG FAISS Vector Index
FAISS_INDEX_PATH=./ml/faiss/agriguard.index
FAISS_DOCS_PATH=./ml/faiss/agriguard_docs.pkl
FAISS_METADATA_PATH=./ml/faiss/agriguard_docs.json
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35

# Multi-Factor Epidemiological XGBoost Risk Model
RISK_MODEL_PATH=./ml/models/risk_model.joblib

# ── Feature & Mock Mode Flags ────────────────────────────────────────────────
# Global mock fallback (Phase 1 legacy compat)
MOCK_ML_MODELS=true

# Vision Pipeline Mock Mode:
# true  = deterministic labeled mock predictions (safe for demo without GPU checkpoint)
# false = real EfficientNet-B0 inference; returns 503 if checkpoint is missing
DIAGNOSIS_MOCK_MODE=true

# Multilingual RAG Advisor Mock Mode:
# true  = deterministic mock advisory responses
# false = real Alibaba DashScope/Qwen API; returns 503 if API key missing
ADVISOR_MOCK_MODE=false

# ── Inference & Severity Thresholds ──────────────────────────────────────────
INFERENCE_CONFIDENCE_THRESHOLD=0.50
EXPERT_CONFIDENCE_THRESHOLD=0.60
SEVERITY_THRESHOLD_LOW=5.0
SEVERITY_THRESHOLD_MODERATE=25.0
SEVERITY_THRESHOLD_SEVERE=50.0

# ── Alibaba Cloud DashScope / Model Studio (Qwen LLM) ────────────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ── Groq LLM (Llama 3.3 / Llama 3.1) ─────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=auto


# ── Open-Meteo Weather API ───────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FORECAST_DAYS=7

# ── Expert Review & Escalation ───────────────────────────────────────────────
EXPERT_WEBHOOK_URL=

# ── File Uploads & Local Static Storage ──────────────────────────────────────
STATIC_DIR=./static
MAX_UPLOAD_SIZE_MB=10

# ── Geospatial Centroids Data ────────────────────────────────────────────────
DISTRICTS_JSON_PATH=../data/districts.json
DATASET_ROOT=../data/raw
